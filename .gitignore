# =============================================================================
# edge 仓库 .gitignore
# 由 git-sync.sh 自动维护兜底，也可手工编辑
# =============================================================================

# ---- 敏感信息（禁止推送到公开仓库）----
# Portainer 管理员明文密码，务必排除！
stacks/portainer_admin_password.txt

# ---- 大体积二进制镜像归档 ----
# 如需纳入版本管理，请用: git add -f stacks/agent.tar
stacks/agent.tar

# ---- 本地运行时产物 ----
*.log
*.tmp
.DS_Store

# ---- 模型（仅忽略权重，放行配置/tokenizer/README/LICENSE 等）----
models/*
!models/*/
models/*/*.safetensors

# ---- 评测结果（benchmark 脚本输出到 logs/benchmark-*）----
logs/benchmark-*/

# ---- 凭据（项目级 git 凭据文件, 含 token, 禁止上传）----
.git-credentials

# ---- 监控栈 obs：敏感凭据（Grafana 密码 / 钉钉机器人 token 与加签密钥）----
# 监控编排与规则文件（docker-compose.yml、prometheus.yml 等）正常纳入版本库
obs/.env
obs/dingtalk.yml
