portainer/portainer_admin_password.txt

# ---- 大体积二进制镜像归档 ----
# 如需纳入版本管理，请用: git add -f portainer/agent.tar
portainer/agent.tar

# ---- 本地运行时产物 ----
*.log
*.tmp
.DS_Store
